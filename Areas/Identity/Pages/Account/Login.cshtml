@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'Rubik', sans-serif;
        margin: 0;
        padding: 0;
        background: radial-gradient(circle at top, #F3F1FA, #E6E1F2);
        overflow: hidden;
    }

    .login-container {
        position: relative;
        z-index: 2;
        max-width: 400px;
        margin: 100px auto;
        background: #fff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #9B7EDC;
    }

    label {
        color: #333;
    }

    .form-control {
        border-radius: 10px;
    }

    .btn-primary {
        background-color: #C29CFF;
        border: none;
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        font-weight: 500;
    }

    .blur-circle {
        position: absolute;
        width: 400px;
        height: 400px;
        background: #c29cff99;
        filter: blur(150px);
        z-index: 1;
        top: -100px;
        left: -100px;
        animation: pulse 8s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }
</style>

<div class="blur-circle"></div>

<div class="login-container">
    <h2>Bienvenido</h2>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-check mt-3">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
        </div>

        <button type="submit" class="btn btn-primary mt-4">Iniciar sesión</button>
    </form>
</div>
